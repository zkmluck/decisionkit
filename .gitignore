__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
.venv/
*.log

# Generated locally. The vendored evaluation set below is tracked on purpose so
# the repository can be evaluated without network access.
/outputs/
/data/*
!/data/typed-decisions/
/data/typed-decisions/*
!/data/typed-decisions/*.jsonl
!/data/typed-decisions/manifest.json
!/data/typed-decisions/README.md
!/data/typed-decisions/LICENSE.txt

# Models are regenerated by `decisionkit train`; the shipped baseline is tracked.
/models/*
!/models/typed-decisions.npz
